{
  "name": "@thewaifu/dsh-market",
  "version": "1.1.2",
  "description": "The dshmarket.ai plugin marketplace inside DeepSeek Harness Web Settings",
  "type": "module",
  "license": "Apache-2.0",
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "plugin-market",
    "dshmarket",
    "webui"
  ],
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json",
    "./client": {
      "types": "./lib/client-types/index.d.ts",
      "default": "./lib/client.js"
    }
  },
  "files": [
    "lib",
    "data",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "node scripts/clean-build.mjs && tsc -p tsconfig.json && tsc -p tsconfig.client.json && tsdown --config tsdown.client.config.mjs",
    "snapshot": "pnpm run build && node scripts/snapshot.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json --noEmit --emitDeclarationOnly false",
    "test": "vitest run",
    "verify": "node scripts/verify-package.mjs",
    "prepack": "pnpm run build && pnpm run test && pnpm run verify",
    "prepare": "pnpm run build"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@types/node": "24.10.1",
    "@types/react": "~18.3.1",
    "lightningcss": "^1.32.0",
    "react": "^18.2.0",
    "tsdown": "^0.22.2",
    "typescript": "5.9.3",
    "vitest": "4.0.18"
  }
}

